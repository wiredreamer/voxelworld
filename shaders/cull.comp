#version 460 core

layout(local_size_x = 64) in;

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

struct AABB {
    vec4 min_point;
    vec4 max_point;
};

layout(set = 0, binding = 0) uniform CullFrustumData {
    vec4 planes[36];
    vec4 eye;
    uint pass_count;
    uint ring_count;
    float rings_per_doubling;
    vec4 rings;
} frustum_data;

layout(set = 1, binding = 0, std430) readonly buffer InputCommands {
    DrawCommand commands[];
} input_commands;

layout(set = 1, binding = 1, std430) readonly buffer InputAABBs {
    AABB aabbs[];
} input_aabbs;

layout(set = 1, binding = 2, std430) writeonly buffer OutputCommands {
    DrawCommand commands[];
} output_commands;

layout(set = 1, binding = 3, std430) buffer Counts {
    uint counts[];
} count_buffer;

layout(set = 1, binding = 4, std430) readonly buffer Visibility {
    uint flags[];
} visibility;

layout(push_constant) uniform PC {
    uint instance_count;
};

bool frustum_test(uint pass, vec3 bmin, vec3 bmax) {
    uint base = pass * 6;
    for (uint i = 0; i < 6; i++) {
        vec4 p = frustum_data.planes[base + i];
        vec3 pv = mix(bmin, bmax, greaterThan(p.xyz, vec3(0.0)));
        if (dot(p.xyz, pv) + p.w < 0.0) return false;
    }
    return true;
}

bool faces_away(uint dir, vec3 bmin, vec3 bmax) {
    vec4 eye = frustum_data.eye;
    switch (dir) {
        case 0u: return eye.x <= bmin.x * eye.w;
        case 1u: return eye.x >= bmax.x * eye.w;
        case 2u: return eye.y <= bmin.y * eye.w;
        case 3u: return eye.y >= bmax.y * eye.w;
        case 4u: return eye.z <= bmin.z * eye.w;
        default: return eye.z >= bmax.z * eye.w;
    }
}

// см. docs/rendering.md#кольца-расстояния
uint ring_of(vec3 bmin, vec3 bmax) {
    vec4 eye    = frustum_data.eye;
    vec3 origin = frustum_data.rings.xyz;

    float away;
    if (eye.w == 0.0) {
        vec3 nearest = mix(bmin, bmax, greaterThan(eye.xyz, vec3(0.0)));
        away         = max(dot(eye.xyz, origin - nearest), 0.0);
    } else {
        away = length(max(max(bmin - origin, origin - bmax), vec3(0.0)));
    }

    float first = frustum_data.rings.w;
    if (away < first) {
        return 0u;
    }
    uint beyond = 1u + uint(log2(away / first) * frustum_data.rings_per_doubling);
    return min(beyond, frustum_data.ring_count - 1u);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= instance_count) return;

    if (visibility.flags[idx] == 0) return;

    vec3 bmin = input_aabbs.aabbs[idx].min_point.xyz;
    vec3 bmax = input_aabbs.aabbs[idx].max_point.xyz;
    bool on_world_axes = input_aabbs.aabbs[idx].min_point.w != 0.0;

    const uint faces = 6u;
    uint stride = instance_count * faces;
    uint ring   = ring_of(bmin, bmax);

    for (uint pass = 0; pass < frustum_data.pass_count; pass++) {
        if (!frustum_test(pass, bmin, bmax)) {
            continue;
        }

        for (uint dir = 0u; dir < faces; dir++) {
            DrawCommand cmd = input_commands.commands[idx * faces + dir];
            if (cmd.index_count == 0 || cmd.instance_count == 0) {
                continue;
            }
            if (pass == 0u && on_world_axes && faces_away(dir, bmin, bmax)) {
                continue;
            }

            uint region = pass == 0u ? ring : frustum_data.ring_count - 1u + pass;
            uint slot   = atomicAdd(count_buffer.counts[region], 1);
            output_commands.commands[region * stride + slot] = cmd;
        }
    }
}
