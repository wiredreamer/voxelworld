#version 460 core

layout(local_size_x = 64) in;

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

struct AABB {
    vec4 min_point;
    vec4 max_point;
};

layout(set = 0, binding = 0) uniform CullFrustumData {
    vec4 planes[36];
    vec4 eye;
    uint pass_count;
    uint ring_count;
    float rings_per_doubling;
    uint hidden_region;
    vec4 rings;
    vec4 view_eye;
    vec4 view_forward;
    vec4 view_right;
    vec4 view_up;
    ivec4 occluder_levels[12];
    uint occluder_level_count;
} frustum_data;

layout(set = 0, binding = 1, std430) readonly buffer OccluderDepths {
    float depths[];
} occluders;

const uint OCCLUSION_OFF   = 0u;
const uint OCCLUSION_CULL  = 1u;
const uint OCCLUSION_CHECK = 2u;

layout(set = 1, binding = 0, std430) readonly buffer InputCommands {
    DrawCommand commands[];
} input_commands;

layout(set = 1, binding = 1, std430) readonly buffer InputAABBs {
    AABB aabbs[];
} input_aabbs;

layout(set = 1, binding = 2, std430) writeonly buffer OutputCommands {
    DrawCommand commands[];
} output_commands;

layout(set = 1, binding = 3, std430) buffer Counts {
    uint counts[];
} count_buffer;

layout(set = 1, binding = 4, std430) readonly buffer Visibility {
    uint flags[];
} visibility;

layout(push_constant) uniform PC {
    uint instance_count;
};

bool frustum_test(uint pass, vec3 bmin, vec3 bmax) {
    uint base = pass * 6;
    for (uint i = 0; i < 6; i++) {
        vec4 p = frustum_data.planes[base + i];
        vec3 pv = mix(bmin, bmax, greaterThan(p.xyz, vec3(0.0)));
        if (dot(p.xyz, pv) + p.w < 0.0) return false;
    }
    return true;
}

bool faces_away(uint dir, vec3 bmin, vec3 bmax) {
    vec4 eye = frustum_data.eye;
    switch (dir) {
        case 0u: return eye.x <= bmin.x * eye.w;
        case 1u: return eye.x >= bmax.x * eye.w;
        case 2u: return eye.y <= bmin.y * eye.w;
        case 3u: return eye.y >= bmax.y * eye.w;
        case 4u: return eye.z <= bmin.z * eye.w;
        default: return eye.z >= bmax.z * eye.w;
    }
}

// см. docs/rendering.md#кольца-расстояния
uint ring_of(vec3 bmin, vec3 bmax) {
    vec4 eye    = frustum_data.eye;
    vec3 origin = frustum_data.rings.xyz;

    float away;
    if (eye.w == 0.0) {
        vec3 nearest = mix(bmin, bmax, greaterThan(eye.xyz, vec3(0.0)));
        away         = max(dot(eye.xyz, origin - nearest), 0.0);
    } else {
        away = length(max(max(bmin - origin, origin - bmax), vec3(0.0)));
    }

    float first = frustum_data.rings.w;
    if (away < first) {
        return 0u;
    }
    uint beyond = 1u + uint(log2(away / first) * frustum_data.rings_per_doubling);
    return min(beyond, frustum_data.ring_count - 1u);
}

// см. docs/rendering.md#отсев-по-заслонам
bool behind_occluders(vec3 bmin, vec3 bmax) {
    const float never = 3.0e38;

    vec3 eye = frustum_data.view_eye.xyz;

    float nearest = never;
    vec2 low      = vec2(never);
    vec2 high     = vec2(-never);
    for (int corner = 0; corner < 8; ++corner) {
        vec3 at = mix(bmin, bmax, bvec3((corner & 1) != 0, (corner & 2) != 0, (corner & 4) != 0)) - eye;

        float depth = dot(at, frustum_data.view_forward.xyz);
        if (depth <= frustum_data.view_forward.w) {
            return false;
        }

        vec2 on = vec2(dot(at, frustum_data.view_right.xyz), dot(at, frustum_data.view_up.xyz)) / depth;
        low     = min(low, on);
        high    = max(high, on);
        nearest = min(nearest, depth);
    }

    ivec4 finest = frustum_data.occluder_levels[0];
    vec2 size    = vec2(finest.yz);

    vec2 from = clamp(vec2(0.5 + (0.5 * low.x), 0.5 - (0.5 * high.y)), vec2(0.0), vec2(1.0)) * size;
    vec2 to   = clamp(vec2(0.5 + (0.5 * high.x), 0.5 - (0.5 * low.y)), vec2(0.0), vec2(1.0)) * size;

    float span = max(to.x - from.x, to.y - from.y);
    int level  = clamp(
        int(ceil(log2(max(span, 1.0)))), 0, int(frustum_data.occluder_level_count) - 1
    );

    ivec4 held  = frustum_data.occluder_levels[level];
    ivec2 edge  = held.yz - 1;
    ivec2 first = min(ivec2(floor(from)) >> level, edge);
    ivec2 last  = min(ivec2(floor(to)) >> level, edge);

    float farthest = 0.0;
    for (int y = first.y; y <= last.y; ++y) {
        for (int x = first.x; x <= last.x; ++x) {
            farthest = max(farthest, occluders.depths[held.x + (y * held.y) + x]);
        }
    }

    return nearest > farthest;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= instance_count) return;

    if (visibility.flags[idx] == 0) return;

    vec3 bmin = input_aabbs.aabbs[idx].min_point.xyz;
    vec3 bmax = input_aabbs.aabbs[idx].max_point.xyz;
    bool on_world_axes = input_aabbs.aabbs[idx].min_point.w != 0.0;

    const uint faces = 6u;
    uint stride = instance_count * faces;
    uint ring   = ring_of(bmin, bmax);

    uint occlusion = uint(frustum_data.view_eye.w);
    bool hidden    = occlusion != OCCLUSION_OFF && behind_occluders(bmin, bmax);

    for (uint pass = 0; pass < frustum_data.pass_count; pass++) {
        if (!frustum_test(pass, bmin, bmax)) {
            continue;
        }
        if (pass == 0u && hidden && occlusion == OCCLUSION_CULL) {
            continue;
        }

        for (uint dir = 0u; dir < faces; dir++) {
            DrawCommand cmd = input_commands.commands[idx * faces + dir];
            if (cmd.index_count == 0 || cmd.instance_count == 0) {
                continue;
            }
            if (pass == 0u && on_world_axes && faces_away(dir, bmin, bmax)) {
                continue;
            }

            uint region = pass != 0u ? frustum_data.ring_count - 1u + pass
                                     : (hidden ? frustum_data.hidden_region : ring);
            uint slot   = atomicAdd(count_buffer.counts[region], 1);
            output_commands.commands[region * stride + slot] = cmd;
        }
    }
}
