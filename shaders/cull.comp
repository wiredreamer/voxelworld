#version 460 core

layout(local_size_x = 64) in;

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

struct AABB {
    // min_point.w is the flag gfx::combined_buffer sets while the instance sits
    // square on the world axes; faces_away is only sound while it is set.
    vec4 min_point;
    vec4 max_point;
};

layout(set = 0, binding = 0) uniform CullFrustumData {
    vec4 planes[36];// six per pass: the camera and each of the five cascades
    vec4 eye;
    uint pass_count;
} frustum_data;

layout(set = 1, binding = 0, std430) readonly buffer InputCommands {
    DrawCommand commands[];
} input_commands;

layout(set = 1, binding = 1, std430) readonly buffer InputAABBs {
    AABB aabbs[];
} input_aabbs;

layout(set = 1, binding = 2, std430) writeonly buffer OutputCommands {
    DrawCommand commands[];
} output_commands;

layout(set = 1, binding = 3, std430) buffer Counts {
    uint counts[];
} count_buffer;

// Written on the CPU by the chunk connectivity walk: zero means no open path
// from the viewer's chunk to this one, so nothing in it can be on screen.
layout(set = 1, binding = 4, std430) readonly buffer Visibility {
    uint flags[];
} visibility;

layout(push_constant) uniform PC {
    uint instance_count;
};

bool frustum_test(uint pass, vec3 bmin, vec3 bmax) {
    uint base = pass * 6;
    for (uint i = 0; i < 6; i++) {
        vec4 p = frustum_data.planes[base + i];
        vec3 pv = mix(bmin, bmax, greaterThan(p.xyz, vec3(0.0)));
        if (dot(p.xyz, pv) + p.w < 0.0) return false;
    }
    return true;
}

// Every face of a mesh is axis aligned in model space, so a whole direction is
// back-facing when the viewer is on the wrong side of the whole box.
// Conservative on purpose: a chunk the eye is inside keeps both sides of that
// axis.
//
// It reads the box in world axes, so it says nothing about an instance turned
// off them: a rotated model points its +X wherever its rotation does, and the
// eye standing past the box on world X told the test to drop a direction that
// was looking straight back at it -- a whole side of the model gone. Those
// instances arrive with the flag clear and keep all six.
//
// Only the camera pass uses it. A shadow cascade would have to test against the
// light instead, and a caster the camera cannot see still casts.
bool faces_away(uint dir, vec3 bmin, vec3 bmax) {
    vec3 eye = frustum_data.eye.xyz;
    switch (dir) {
        case 0u: return eye.x <= bmin.x;   // +X
        case 1u: return eye.x >= bmax.x;   // -X
        case 2u: return eye.y <= bmin.y;   // +Y
        case 3u: return eye.y >= bmax.y;   // -Y
        case 4u: return eye.z <= bmin.z;   // +Z
        default: return eye.z >= bmax.z;   // -Z
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= instance_count) return;

    if (visibility.flags[idx] == 0) return;

    vec3 bmin = input_aabbs.aabbs[idx].min_point.xyz;
    vec3 bmax = input_aabbs.aabbs[idx].max_point.xyz;
    bool on_world_axes = input_aabbs.aabbs[idx].min_point.w != 0.0;

    const uint faces = 6u;
    uint stride = instance_count * faces;

    for (uint pass = 0; pass < frustum_data.pass_count; pass++) {
        if (!frustum_test(pass, bmin, bmax)) {
            continue;
        }

        for (uint dir = 0u; dir < faces; dir++) {
            DrawCommand cmd = input_commands.commands[idx * faces + dir];
            if (cmd.index_count == 0 || cmd.instance_count == 0) {
                continue;
            }
            if (pass == 0u && on_world_axes && faces_away(dir, bmin, bmax)) {
                continue;
            }

            uint slot = atomicAdd(count_buffer.counts[pass], 1);
            output_commands.commands[pass * stride + slot] = cmd;
        }
    }
}
