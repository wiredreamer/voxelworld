#version 450

#define OCCUPANCY_SET 0
#include "occupancy.glsl"
#include "light_cascades.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, set = 1, binding = 3) readonly buffer LightBricks {
    ivec4 bricks[];
} queue;

const int BRICK_TEXELS   = 8;
const int SEEDS_FROM_SKY = 8;
const int LAST_PASS      = 16;
const int WIPES_SOURCES  = 32;
const int NEAR_SOURCES   = 64;

const float SKY_REACH      = 1024.0;
const float SKY_LEVEL      = 0.99;
const int SOLID_SUB_BLOCKS = 5;

const float SOURCE_STRIDE = 1.25;
const float EDGE_LENGTH   = 1.41421356;
const float CORNER_LENGTH = 1.73205081;

const ivec3 NEIGHBOURS[6] = ivec3[6](
    ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0), ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1)
);

const vec4 OPEN_SKY = vec4(0.0, 0.0, 0.0, 1.0);

bool cellHoldsSolid(ivec3 lowVoxel, int cascade) {
    if (!occupancyKnows(lowVoxel >> OCCUPANCY_CHUNK_SHIFT, cascade)) {
        return false;
    }

    uint brick = occupancyBrickAt(lowVoxel, cascade);
    if (cascade == 0) {
        return ((brick >> occupancyBrickBit(lowVoxel)) & 1u) != 0u;
    }
    return bitCount(brick) >= SOLID_SUB_BLOCKS;
}

bool windowHolds(int cascade, ivec3 texel) {
    ivec3 inside = texel - push.window[cascade].xyz;
    return all(greaterThanEqual(inside, ivec3(0))) &&
           all(lessThanEqual(inside, ivec3(SIDE_MASK[cascade])));
}

vec4 lightAt(int cascade, ivec3 texel) {
    ivec3 lowVoxel = texel << CELL_SHIFT[cascade];
    while (!windowHolds(cascade, texel)) {
        if (cascade == LAST_CASCADE) {
            return OPEN_SKY;
        }
        cascade += 1;
        texel   = lowVoxel >> CELL_SHIFT[cascade];
    }
    return readCascade(cascade, texel & SIDE_MASK[cascade]);
}

vec2 lightInsideSolid(ivec3 lowVoxel, ivec3 texel, int cascade, bool widened) {
    int cellVoxels = 1 << CELL_SHIFT[cascade];

    vec2 gathered = vec2(0.0);
    float open    = 0.0;
    for (int side = 0; side < 6; ++side) {
        if (cellHoldsSolid(lowVoxel + (NEIGHBOURS[side] * cellVoxels), cascade)) {
            continue;
        }
        gathered += lightAt(cascade, texel + NEIGHBOURS[side]).ga;
        open     += 1.0;
    }
    if (open > 0.0) {
        return gathered / open;
    }
    if (!widened) {
        return vec2(0.0);
    }

    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec3 beside = ivec3(x, y, z);
                if (abs(x) + abs(y) + abs(z) < 2 ||
                    cellHoldsSolid(lowVoxel + (beside * cellVoxels), cascade)) {
                    continue;
                }
                gathered += lightAt(cascade, texel + beside).ga;
                open     += 1.0;
            }
        }
    }
    return open > 0.0 ? gathered / open : vec2(0.0);
}

bool columnSeesSky(vec3 origin, int cascade) {
    return !marchOccupancy(
        push.base_chunk.xyz, origin, vec3(0.0, 1.0, 0.0), SKY_REACH, max(cascade - 1, 0)
    ).found;
}

float skyShare(ivec3 lowVoxel, int cascade) {
    float cell = float(1 << CELL_SHIFT[cascade]);
    vec3 centre = vec3(lowVoxel - (push.base_chunk.xyz << OCCUPANCY_CHUNK_SHIFT)) + vec3(0.5 * cell);
    if (cascade == 0) {
        return columnSeesSky(centre, cascade) ? 1.0 : 0.0;
    }

    float open = 0.0;
    for (int column = 0; column < 4; ++column) {
        vec2 aside = (vec2(float(column & 1), float(column >> 1)) - 0.5) * (0.5 * cell);
        open       += columnSeesSky(centre + vec3(aside.x, 0.0, aside.y), cascade) ? 0.25 : 0.0;
    }
    return open;
}

uint faceBit(int axis, int along) {
    return 1u << uint((axis * 2) + (along < 0 ? 1 : 0));
}

float sourcesAcrossCorners(ivec3 lowVoxel, ivec3 texel, int cascade, uint openFaces, float stride) {
    int cellVoxels = 1 << CELL_SHIFT[cascade];

    float strongest = 0.0;
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                int steps = abs(x) + abs(y) + abs(z);
                if (steps < 2) {
                    continue;
                }

                uint towards = (x != 0 ? faceBit(0, x) : 0u) | (y != 0 ? faceBit(1, y) : 0u) |
                               (z != 0 ? faceBit(2, z) : 0u);
                if ((openFaces & towards) == 0u) {
                    continue;
                }

                ivec3 beside = ivec3(x, y, z);
                vec4 light   = lightAt(cascade, texel + beside);
                bool solid   = cellHoldsSolid(lowVoxel + (beside * cellVoxels), cascade);

                float span = steps == 2 ? EDGE_LENGTH : CORNER_LENGTH;
                strongest  = max(strongest, (solid ? light.r : light.g) - (stride * span));
            }
        }
    }
    return strongest;
}

vec4 tintAt(int cascade, ivec3 block) {
    ivec3 lowVoxel = block << (CELL_SHIFT[cascade] + TINT_SHIFT);
    while (!windowHolds(cascade, block << TINT_SHIFT)) {
        if (cascade == LAST_CASCADE) {
            return vec4(0.0);
        }
        cascade += 1;
        block   = lowVoxel >> (CELL_SHIFT[cascade] + TINT_SHIFT);
    }
    return readTint(cascade, block & (SIDE_MASK[cascade] >> TINT_SHIFT));
}

const float TINT_REACH = 0.85;

vec3 sourceColour(float packed) {
    int bits = int(round(packed * 255.0));
    return vec3(float(bits >> 5) / 7.0, float((bits >> 2) & 7) / 7.0, float(bits & 3) / 3.0);
}

vec3 tintFrom(int cascade, ivec3 block, float cost) {
    vec3 beside = tintAt(cascade, block).rgb;
    float top   = max(beside.r, max(beside.g, beside.b));
    return top > cost ? beside * (1.0 - (cost / top)) : vec3(0.0);
}

// см. docs/lighting.md#цвет-света-ламп
void settleTint(int cascade, ivec3 texel, bool lamps, bool wiped) {
    ivec3 block = texel >> TINT_SHIFT;
    ivec3 held  = block & (SIDE_MASK[cascade] >> TINT_SHIFT);

    if (!lamps) {
        writeTint(cascade, held, vec4(0.0));
        return;
    }

    float packed = wiped ? 0.0 : readTint(cascade, held).a;

    float source = 0.0;
    if (packed > 0.0) {
        for (int corner = 0; corner < 8; ++corner) {
            ivec3 inside = texel + ivec3(corner & 1, (corner >> 1) & 1, corner >> 2);
            source       = max(source, readCascade(cascade, inside & SIDE_MASK[cascade]).r);
        }
    }

    float pace = (SOURCE_STRIDE * float(2 << CELL_SHIFT[cascade]) * TINT_REACH) / FULL_LEVEL;

    vec3 level = sourceColour(packed) * source;
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                int steps = abs(x) + abs(y) + abs(z);
                if (steps == 0) {
                    continue;
                }

                float span = steps == 1 ? 1.0 : (steps == 2 ? EDGE_LENGTH : CORNER_LENGTH);
                level      = max(level, tintFrom(cascade, block + ivec3(x, y, z), pace * span));
            }
        }
    }

    writeTint(cascade, held, vec4(level, packed));
}

void main() {
    ivec4 brick   = queue.bricks[gl_WorkGroupID.x];
    int cascade   = brick.w & CASCADE_BITS;
    bool reseeded = (brick.w & SEEDS_FROM_SKY) != 0;
    bool closing  = (brick.w & LAST_PASS) != 0;
    bool lamps    = (brick.w & NEAR_SOURCES) != 0;

    ivec3 texel    = (brick.xyz * BRICK_TEXELS) + ivec3(gl_LocalInvocationID);
    ivec3 stored   = texel & SIDE_MASK[cascade];
    ivec3 lowVoxel = texel << CELL_SHIFT[cascade];
    int cellVoxels = 1 << CELL_SHIFT[cascade];

    if (all(equal(gl_LocalInvocationID & 1u, uvec3(0u)))) {
        settleTint(cascade, texel, lamps, (brick.w & WIPES_SOURCES) != 0);
    }

    vec4 own     = readCascade(cascade, stored);
    float source = (brick.w & WIPES_SOURCES) != 0 ? 0.0 : own.r;

    if (cellHoldsSolid(lowVoxel, cascade)) {
        vec2 around = lightInsideSolid(lowVoxel, texel, cascade, closing);
        writeCascade(cascade, stored, vec4(source, lamps ? around.x : 0.0, 0.0, around.y));
        return;
    }

    float underSky = reseeded ? skyShare(lowVoxel, cascade) : own.b;
    float stride   = (SOURCE_STRIDE * float(cellVoxels)) / FULL_LEVEL;

    float level = 1.0;
    float lamp  = 0.0;
    if (lamps || underSky < SKY_LEVEL) {
        float brightest = 0.0;
        uint openFaces  = 0u;

        for (int side = 0; side < 6; ++side) {
            bool solid = cellHoldsSolid(lowVoxel + (NEIGHBOURS[side] * cellVoxels), cascade);
            if (solid && !lamps) {
                continue;
            }

            vec4 beside = lightAt(cascade, texel + NEIGHBOURS[side]);
            if (solid) {
                lamp = max(lamp, beside.r - stride);
                continue;
            }

            openFaces |= 1u << uint(side);
            brightest = max(brightest, beside.a);
            lamp      = max(lamp, beside.g - stride);
        }

        if (underSky < SKY_LEVEL) {
            float pace   = (cascade > 0 && brightest > SKY_LEVEL) ? 0.5 : 1.0;
            float spread = max(brightest - ((pace * float(cellVoxels)) / FULL_LEVEL), 0.0);
            level        = mix(spread, 1.0, underSky);
        }

        if (lamps && lamp > 0.0) {
            lamp = max(lamp, sourcesAcrossCorners(lowVoxel, texel, cascade, openFaces, stride));
        }
        lamp = lamps ? max(lamp, source) : 0.0;
    }

    writeCascade(cascade, stored, vec4(source, lamp, underSky, level));
}
