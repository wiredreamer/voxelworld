#version 450

#include "light_cascades.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 1, binding = 4) readonly buffer LightSources {
    ivec4 cells[];
} sources;

const int LEVEL_SHIFT = 8;
const int LEVEL_MASK  = 15;
const int TINT_AT     = 12;
const int TINT_MASK   = 255;

void main() {
    if (gl_GlobalInvocationID.x >= uint(push.base_chunk.w)) {
        return;
    }

    ivec4 cell  = sources.cells[gl_GlobalInvocationID.x];
    int cascade = cell.w & CASCADE_BITS;
    ivec3 held  = cell.xyz & SIDE_MASK[cascade];

    vec4 light = readCascade(cascade, held);
    light.r    = float((cell.w >> LEVEL_SHIFT) & LEVEL_MASK) / FULL_LEVEL;
    writeCascade(cascade, held, light);

    ivec3 block = (cell.xyz >> TINT_SHIFT) & (SIDE_MASK[cascade] >> TINT_SHIFT);

    vec4 tint = readTint(cascade, block);
    tint.a    = float((cell.w >> TINT_AT) & TINT_MASK) / 255.0;
    writeTint(cascade, block, tint);
}
