{
  "name": "voxel-world",
  "version-string": "0.0.1",
  "dependencies": [
    {
      "name": "catch2",
      "version>=": "3.15.3"
    }
  ],
  "default-features": [
    "gfx"
  ],
  "features": {
    "gfx": {
      "description": "Window, renderer and debug UI dependencies",
      "dependencies": [
        {
          "name": "glfw3",
          "version>=": "3.4"
        },
        {
          "name": "imgui",
          "version>=": "1.92.8",
          "features": [
            "glfw-binding",
            "vulkan-binding"
          ]
        },
        {
          "name": "vulkan-headers",
          "version>=": "1.4.350.1"
        },
        {
          "name": "stb"
        }
      ]
    }
  },
  "builtin-baseline": "39344dff01c5a5a0134caf2624cdd492f05d30ea"
}
