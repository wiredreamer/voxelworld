export module vw.world:light.column;

import std;

import vw.core;
import vw.asset;

export namespace vw::asset {

// К какому из двух светов относится уровень. Оба живут в одном байте — небо в
// младшем полубайте, свет блоков в старшем — потому что уровень укладывается в
// 0..15, а массив и так был байтом на воксель с пустой половиной. Второй массив
// стоил бы пяти мегабайт на воркер впустую.
enum class light_channel : uint8 { sky = 0, block = 1 };

[[nodiscard]] constexpr auto shift_of(light_channel channel) -> int32 {
    return channel == light_channel::sky ? 0 : 4;
}


// Буферы, в которых идёт одна заливка. Семь мегабайт на колонку в девять чанков:
// пять под уровни и по мегабайту с четвертью на две битовых плоскости. Всё это
// пишется один раз, читается один раз и больше никому не нужно.
//
// Просить у аллокатора семь мегабайт на колонку значит семь мегабайт свежих
// страниц на колонку, подгружаемых по одной при первом касании и тут же
// возвращаемых. Передача буферов внутрь и обратно позволяет воркеру держать один
// комплект всю свою жизнь.
//
// Очищаются они всё равно на каждой колонке: заливка пишет только туда, куда
// дошёл свет, и не выше самой колонки, поэтому колонка, взявшая остатки
// предыдущей, нашла бы свой потолок уже освещённым.
struct light_scratch {
    std::vector<uint8> levels;
    std::vector<uint64> solid;
    std::vector<uint64> sky;
    std::vector<int32> frontier;
    std::vector<int32> next;

    // Затравки разложены по уровню, с которого входят в распространение. Небо
    // кладёт всё в ячейку 15 и на том всё; у света блоков источник есть на каждое
    // излучение из реестра, и факел на 14 обязан ждать своей очереди за лавой на
    // 15, иначе распространение дошло бы до него сверху и прошло бы его дважды.
    std::array<std::vector<int32>, 16> seeds;
};

// Небесный свет над одной колонкой чанков, скопирован с Minecraft дословно.
//
// Правил два, и значение имеет второе. Воксель стоит на 15, если над ним в его
// же колонке нет ничего непрозрачного — в этом всё «вниз идёт бесплатно», и
// работает оно только под открытым небом. Всё остальное — заливка от этих
// затравок: шесть соседей, уровень за шаг, во все стороны включая вниз. Стоило
// свету обойти хоть что-то, и падает он не быстрее, чем расходится вбок — вот
// что превращает вход в пещеру в градиент, а не в столб света.
//
// Непрозрачность здесь двоичная, поэтому шаг всегда стоит ровно единицу, а
// max(1, opacity) из Minecraft вырождается. Свет внутри сплошных вокселей не
// читается никогда: выборка всегда берётся в углу видимой грани, то есть с
// воздушной стороны.
//
// Заливка идёт по колонке плюс юбка в пятнадцать вокселей, взятая у восьми
// соседей, а сохраняется только середина. Это делает ответ точным, а не почти
// верным: источник за юбкой отстоит от любого вокселя середины не меньше чем на
// шестнадцать шагов, то есть даёт max(0, 15 - 16) = 0. Плотная граница — 14,
// пятнадцатый воксель взят с запасом на промах в углах.
//
// Хранение здесь плотное, байт на воксель по объёму с юбкой, и рассчитано на то,
// что колонку построят на воркере, прочитают один раз и выбросят. Переживает её
// light_field, по одному страничному чанку.
class light_column {
public:
    static constexpr int32 side      = chunk_occupancy::side;
    static constexpr int32 apron     = 15;
    static constexpr int32 span      = side + (2 * apron);
    static constexpr int32 page      = 8;
    static constexpr uint8 max_level = 15;

    // Одна из девяти колонок: занятость, по которой идёт заливка, и модели, из
    // которых читаются излучатели. Обе снизу вверх от общего для всего мира пола,
    // поэтому общий пол предполагать можно, а общий потолок — нет.
    //
    // Пустая занятость — это колонка, которой нет вовсе, и читается она как
    // сплошная порода: света не даёт и сквозь себя не пускает. Над верхушкой
    // колонки, которая *есть*, — открытый воздух, и его засевает правило первое;
    // это и не даёт равнине рядом с горой оказаться замурованной в темноте.
    //
    // Модели обходятся постранично и только там, где что-то излучает, поэтому
    // пустой span здесь не ошибка, а обычный ответ для всего, где нет светящихся
    // блоков, — и именно его передают конструкторы «только небо».
    struct column_slice {
        std::span<const chunk_occupancy* const> occupancy;
        std::span<const model* const> models;
    };

    // Индексируется как (dz + 1) * 3 + (dx + 1), поэтому середина — индекс 4.
    using neighbourhood = std::array<column_slice, 9>;

    explicit light_column(const neighbourhood& around)
        : light_column{around, emission_table{}, {}} {}

    // То же самое, но в буферах, которые держит кто-то другой. Забрать их обратно
    // через release(), когда запекание закончено.
    light_column(const neighbourhood& around, const emission_table& emission,
                 light_scratch scratch);

    // Одна колонка с запечатанными боками, только небо. Точна лишь там, где
    // ничего снаружи не важно, — ради остального и существует форма с юбкой.
    explicit light_column(std::span<const chunk_occupancy* const> chunks_bottom_up);

    // Буферы обратно, следующей колонке. Позади остаётся перемещённая колонка,
    // читать её нельзя.
    [[nodiscard]] auto release() && -> light_scratch {
        return std::move(buffers_);
    }

    [[nodiscard]] auto height() const -> int32 {
        return height_;
    }

    // x и z адресуют среднюю колонку, 0..63; y считается вверх от низа.
    [[nodiscard]] auto level_at(int32 x, int32 y, int32 z,
                                light_channel channel = light_channel::sky) const -> uint8 {
        const uint8 byte =
            buffers_.levels[static_cast<std::size_t>(index_(x + apron, y, z + apron))];
        return static_cast<uint8>((byte >> shift_of(channel)) & 0x0FU);
    }

    // Один чанк средней колонки в том виде, в каком он хранится: тот, чей пол
    // стоит на y_base вокселей выше пола колонки. Всё, что колонка не покрывает,
    // возвращается тёмным, а не читается за её концом.
    [[nodiscard]] auto bake(int32 y_base, light_channel channel) const -> light_field;

private:
    // Шестьдесят четыре уровня средней колонки вдоль x, подряд. Запекание чанка
    // читает колонку именно так; воксель за вокселем через level_at каждое чтение
    // попадало бы в свою строку кэша и стоило бы дороже породившей его заливки.
    [[nodiscard]] auto row_(int32 y, int32 z) const -> const uint8* {
        return &buffers_.levels[static_cast<std::size_t>(index_(apron, y, z + apron))];
    }

    [[nodiscard]] static auto index_(int32 x, int32 y, int32 z) -> int32 {
        return (((y * span) + z) * span) + x;
    }

    [[nodiscard]] auto solid_at_(int32 x, int32 y, int32 z) const -> bool;

    auto build_solid_(const neighbourhood& around) -> void;

    // Правило первое и затравки с его края. Только небо — это единственный канал,
    // чьи источники есть свойство формы, а не того, что за блок.
    auto seed_sky_() -> void;

    // Другой посев: что говорят блоки. Два обхода страниц, и второй обязан быть
    // вторым — есть ли источнику что отдать, зависит от уровня, которым засеяли
    // соседей, а сосед может жить в ещё не обойдённой странице.
    auto seed_block_(const neighbourhood& around, const emission_table& emission) -> void;

    // Правило второе, общее. Когда затравки разложены по корзинам, каналы
    // неразличимы: шесть соседей, уровень за шаг.
    auto spread_(light_channel channel) -> void;

    int32 height_ = 0;
    light_scratch buffers_;
};

}  // namespace vw::asset
