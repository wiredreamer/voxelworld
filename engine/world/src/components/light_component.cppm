export module vw.world:components.light;

import std;

import vw.core;
import vw.ecs;
import :spatial;

export namespace vw::ecs {

class animation_fsm_system;
class animation_system;
class character_controller_system;
class hierarchy_system;
class light_system;
class model_system;
class physics_system;
class socket_system;
class spatial_system;
class transform_system;
class world_grid_system;

// Свет, который движется и потому не запекается. Его затухание описывают два
// числа, и это те же два, что уже есть у запечённого канала, только под другим
// именем: воксель с излучением L в мире с размером вокселя s достаёт на L * s и даёт
// пик L / 15, поэтому intensity — этот пик, а range — эта дальность. Записанное
// так, оно позволяет шейдеру гонять для обоих одну функцию, отчего брошенный факел
// не меняет яркость в тот миг, когда ложится вокселем.
//
// Трёх коэффициентов затухания, живших здесь раньше, больше нет. Они описывали
// кривую 1/(c + ld + qd^2), умноженную на второе сглаживающее окно, совпадали с
// запечённым затуханием ровно на нулевом расстоянии и давали три ручки, чтобы с
// ним разойтись.
struct light_component final {
    [[nodiscard]] auto get_color() const -> const vec3f& {
        return color_;
    }

    // Яркость там, где стоит источник, 0..1. Для того, что ляжет вокселем, — его
    // излучение, делённое на пятнадцать.
    [[nodiscard]] auto get_intensity() const -> float32 {
        return intensity_;
    }

    // Насколько далеко достаёт, в мировых единицах, и это жёсткая граница:
    // затухание линейно по расстоянию и обращается в ноль ровно здесь. Источник
    // круглый там, где запечённая лужа вокселя — ромб, поэтому на полу они совпадают
    // на четырёх пятых дальности: излучение на размер вокселя мира на sqrt(2/pi),
    // отношение круга к квадрату той же ширины.
    [[nodiscard]] auto get_range() const -> float32 {
        return range_;
    }

private:
    friend class light_system;

    vec3f color_{1.0F, 1.0F, 1.0F};
    float32 intensity_ = 1.0F;
    float32 range_     = 10.0F;
};

// Мягкое тёмное пятно на том, что тело собой закрывает, чтобы оно не читалось
// парящим: всего плотнее под ним, слабее на стене рядом и тем слабее, чем выше
// тело поднялось. Не тень и намеренно не она: пятно не знает, где солнце, и
// потому стоит на месте, пока сменяется день. Настоящая тень, следящая за
// солнцем, — это то, ради чего были каскады, а они выключены: за первым край шёл
// лесенкой, и лесенка ползла вслед за камерой. Код по-прежнему в дереве, за
// shadow_settings::enabled и SHADOW_ENABLED, и они обязаны совпадать.
//
// И не декаль. Это множитель во фрагментном шейдере: нет ни луча вниз до пола, ни
// того, что сломается на лестнице или склоне, ни вызова отрисовки, и на краю
// обрыва пятно обрывается сам собой — земли, на которую оно легло бы, там просто
// нет.
//
// Гасит весь свет, дошедший до поверхности, а не одно небо с солнцем: поверхности
// нет дела до того, какой именно свет до неё не добрался. Цену этого — круглое
// пятно там, где тень от лампы должна отклоняться в сторону, — называет
// blobShadow в voxel.frag.
//
// Задаётся один раз, при конструировании: после появления тела эти числа никто не
// двигает, и модификатор для них был бы тремя сеттерами, которых никто не зовёт.
struct blob_shadow_component final {
    blob_shadow_component() = default;

    blob_shadow_component(float32 radius, float32 fall, float32 strength)
        : radius_{radius}, fall_{fall}, strength_{strength} {}

    // Ширина диска в мировых единицах. Берётся от собственной ширины тела.
    [[nodiscard]] auto get_radius() const -> float32 {
        return radius_;
    }

    // Высота, на которой диск вдвое уже и вчетверо бледнее: масштаб, на котором
    // сказывается отрыв от земли. Именно это заставляет прыжок читаться прыжком —
    // пятно стягивается к точке, когда ноги отрываются, как и всё имеющее
    // постоянный размер при подъёме.
    //
    // Она же задаёт, насколько глубоко вниз пятно достаёт вообще: несколько таких
    // высот, а дальше затухание в ничто. Раньше такой границы не было — диск
    // сужается вечно и до конца не исчезает, — и это годилось, пока восемь пятен
    // ехали в кадровом uniform и каждый пиксель земли обходил все восемь.
    // Годиться перестало, когда пятна легли в список на кластер: ничто
    // неограниченное нельзя положить в список мест, до которых оно достаёт. Числом
    // владеет рендерер, см. gfx::blob_reach_falls.
    [[nodiscard]] auto get_fall() const -> float32 {
        return fall_;
    }

    // Насколько тёмной становится середина, 0..1.
    [[nodiscard]] auto get_strength() const -> float32 {
        return strength_;
    }

private:
    float32 radius_   = 12.0F;
    float32 fall_     = 48.0F;
    float32 strength_ = 0.55F;
};

}  // namespace vw::ecs
