export module vw.gfx:renderer.settings;

import std;

import vw.core;

export namespace vw::gfx {

enum class render_mode : uint8 { lit, wireframe };

inline constexpr std::array<std::string_view, 2> render_mode_names{"lit", "wireframe"};

struct directional_light_settings {
    vec3f direction{0.0f, -1.0f, 0.0f};
    vec3f color{1.f, 1.f, 1.f};
    float32 intensity{1.0f};

    // Насколько терминатор утащен за девяносто градусов. Шесть осевых нормалей
    // дают скалярному произведению шесть значений и не больше, и при солнце в
    // зените три вертикальные грани из четырёх получают ровно ноль — +X, -X и -Z
    // выходят одного цвета, потому что рассеянный свет читает normal.y и тоже их
    // не различает. На половине каждая получает своё число, а грань, отвёрнутая
    // полностью, по-прежнему не получает ничего.
    float32 wrap{0.5f};
};

// Свет, который поверхность получает от всего, что не является источником: от
// неба сверху и от того, что отражает земля. Без текстур это единственное, что
// отличает одну грань вокселя от другой там, куда не достаёт солнце, поэтому здесь
// полусфера, а не константа: плоский рассеянный свет делает неосвещённый воксель
// одноцветным, а так выглядит пластик.
struct ambient_settings {
    vec3f sky{0.34f, 0.42f, 0.52f};
    vec3f ground{0.16f, 0.14f, 0.13f};
    float32 strength{1.15f};

    // Насколько рассеянный свет проседает в полностью закрытом углу и по какой
    // кривой туда идёт сырое затенение. Выборки — целые от нуля до трёх, поэтому
    // кривая единственная решает, где стоит середина ската: ниже единицы она
    // размазывает затенение по грани, выше — стягивает его обратно в угол.
    float32 ao_strength = 0.65f;
    float32 ao_curve    = 1.0f;

    // Тот же множитель в другую сторону: насколько ярче угол там, где он торчит,
    // а не заперт, и по какой кривой идёт этот скат. Затенение умеет только
    // затемнять, поэтому без этого верхняя грань под открытым небом ровно так же
    // ярка, как любая другая верхняя грань, и рельеф читается плоским с той
    // стороны, где обрывы.
    float32 convex_strength = 0.35f;
    float32 convex_curve    = 2.0f;

    // Чем освещено место, куда не доходит небо. Собственный цвет, а не доля неба
    // сверху, — чтобы запертая комната сохраняла яркость, пока над её потолком
    // сменяется день.
    vec3f cave{0.05f, 0.055f, 0.07f};

    // Кривая, по которой видимость неба идёт от запечатанного к открытому. Ниже
    // единицы дневной свет заходит глубже в устье пещеры, выше — останавливается
    // у входа.
    float32 sky_curve = 1.0f;

    // Та же видимость на пути к солнцу, которой нужна своя, более крутая кривая.
    // Небесный свет огибает углы, потому что он заливка; солнце не огибает ничего
    // и потому обязано пропасть заметно раньше неба. На единице они совпадают, и
    // дневной свет заползает в пещеру на пятнадцать вокселей.
    float32 sun_curve = 2.0f;
};

// То, что превращает свет в пиксель. Swapchain — восемь бит на канал, и
// фрагментный шейдер пишет прямо в него, поэтому без кривой всё, что выше
// единицы, просто срезается — а в полдень освещённая верхняя грань уходит за
// единицу в своём сильнейшем канале ещё до того, как хоть что-то в свете стало
// неверным. Срезанная верхушка стоит вдвойне: цвет ползёт к белому, и всякая
// подсказка формы поверх него перестаёт менять картинку, потому что меняемое ею
// число уже упёрлось в потолок.
struct tonemap_settings {
    // Применяется до кривой, поэтому двигает картинку целиком, а не разменивает
    // один её край на другой.
    float32 exposure = 1.3f;

    // Уровень света, выходящий ровно единицей. Ниже него кривая почти прямая, и
    // ничто между нулём и этой точкой не теряется. Точечным источникам и свечению
    // понадобится значение больше, чем одному дневному свету.
    float32 white_point = 1.75f;
};

// Не настройка, а способ смотреть. Освещение — произведение собственного цвета
// вокселя на всё, что на него падает, и судить об одном множителе по произведению
// значит гадать. Каждый из этих режимов показывает один множитель отдельно.
enum class debug_view : uint32 {
    off = 0,
    ambient_occlusion,
    normals,
    sky_light,
    convexity,
    block_light,
    blob_shadow,

    // Сколько источников фроксельная сетка положила в каждый кластер. Прибор для
    // разбора прохода, а не украшение: без него «свет подешевел» читается только
    // по кадровому времени, которое мешает всё вместе.
    light_complexity,

    // То же для тел. Белый — кластер, чей список переполнился; теперь, когда
    // предела на число тел в кадре нет, это единственный способ потерять пятно.
    blob_complexity,
};

// Имена живут рядом с перечислением, а не в интерфейсе, который их показывает:
// показывающих несколько, и разъехаться им негде только так.
inline constexpr std::array<std::string_view, 9> debug_view_names{
    "off",         "ambient occlusion", "normals",
    "sky light",   "convexity",         "block light",
    "blob shadow", "light complexity",  "blob complexity",
};

static_assert(
    debug_view_names.size() == static_cast<std::size_t>(debug_view::blob_complexity) + 1
);

// Что излучает запечённый светящийся воксель. Один цвет на все такие воксели мира —
// так делает Minecraft, и столько позволяет один полубайт на угол: уровень
// говорит, сколько света дошло, а это — как он выглядит. Цвет на источник
// потребовал бы трёх полубайтов на угол, а свободен один.
struct block_light_settings {
    vec3f color{1.0f, 0.86f, 0.62f};
    float32 intensity{1.0f};

    // Кривая, по которой запечённый уровень идёт от темноты к полному свету.
    // Заметно выше единицы намеренно: пятнадцать равных ступеней читаются как
    // нарисованный на стене скат, а не как затухание света от лампы. Двойка близка
    // к кривой лайтмапа самого Minecraft, то есть f / (4 - 3f).
    float32 curve{2.0f};

    // Сколько собственного свечения вокселя доходит до кадра. На единице воксель со
    // свечением 255 выходит ровно того цвета, каким нарисован, там, где его
    // ничто больше не освещает, — единственное значение этой настройки, имеющее
    // смысл, а не вкус, и то, к которому стоит возвращаться, когда картинка
    // поехала.
    float32 glow{1.0f};
};

// Фроксельная сетка, из которой читает освещение. slices = 1 — это ровно плоские
// тайлы, то есть цена резки по глубине меряется одной сборкой, а не сравнением
// двух.
//
// enabled — не вкус: с выключенной сеткой фрагмент обходит все источники кадра, и
// только так «картинка не изменилась» остаётся проверяемым, а не утверждаемым.
struct cluster_settings {
    uint32 tile_size = 32;
    uint32 slices    = 24;
    uint32 cap       = 32;

    // Пятна под телами делят сетку, но не предел: кластер, держащий шестнадцать
    // таких, — это толпа, стоящая друг на друге.
    uint32 blob_cap = 16;
    bool enabled    = true;
};

struct fog_settings {
    vec3f color{0.1f, 0.1f, 0.1f};
    float32 near_distance{256.0f};
    float32 far_distance{512.0f};
    bool enabled{true};
};

}  // namespace vw::gfx
