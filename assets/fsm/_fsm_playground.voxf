# Voxf File Version 1.0
rig humanoid
entry idle
param speed float
param grounded bool true
param combo int
param attack trigger
state idle
	clip animations/a_idle.voxa
	playback loop
	to walk
		when speed > 0
		blend 0.15
	to attack
		on attack
		blend 0.1
state walk
	clip animations/a_walk.voxa
	playback loop
	rate 1.25
	to idle
		when speed == 0
		blend 0.15
	to attack
		on attack
		when grounded == true
		blend 0.1
state attack
	clip animations/a_sword_attack.voxa
	playback once
	rate 2
	fade_in 0.25
	fade_out 0.35
	to idle
		wait end
		wait blend
any
	to idle
		when grounded == false
		when combo >= 3
		blend 0.2
