# Voxf File Version 1.0
rig humanoid
entry idle
param speed float
param air_state int
state idle
	clip animations/a_humanoid_idle.voxa
	playback loop
	to run
		when speed > 0
		blend 0.15
	to rise
		when air_state == 1
		blend 0.1
	to fall
		when air_state == 2
		blend 0.15
state run
	clip animations/a_humanoid_run_f.voxa
	playback loop
	to idle
		when speed == 0
		blend 0.15
	to rise
		when air_state == 1
		blend 0.1
	to fall
		when air_state == 2
		blend 0.15
state rise
	clip animations/a_jump_left.voxa
	playback loop
	to fall
		when air_state == 2
		blend 0.15
	to idle
		when air_state == 0
		blend 0.2
state fall
	clip animations/a_jump_left.voxa
	playback loop
	to rise
		when air_state == 1
		blend 0.1
	to idle
		when air_state == 0
		blend 0.2
