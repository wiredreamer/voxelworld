# Voxf File Version 1.0
rig humanoid
entry idle
param speed float
param air_state int
param land trigger
param land_hard trigger
param dodge_roll trigger
param dodge_dash trigger
param dir_x float
param dir_z float
param stance bool
state idle
	clip animations/a_humanoid_idle.voxa
	playback loop
	to stance_idle
		when stance == 1
		blend 0.15
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to run
		when speed > 0
		blend 0.15
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
state run
	clip animations/a_humanoid_run_f.voxa
	playback loop
	to stance_idle
		when stance == 1
		blend 0.15
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to idle
		when speed == 0
		blend 0.15
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
state rise
	clip animations/a_humanoid_jump_takeoff.voxa
	playback once
	to land_hard
		on land_hard
		blend 0.05
	to land
		on land
		blend 0.05
	to fall
		when air_state == 2
		blend 0.1
	to idle
		when air_state == 0
		blend 0.15
state fall
	clip animations/a_humanoid_fall.voxa
	playback loop
	to land_hard
		on land_hard
		blend 0.05
	to land
		on land
		blend 0.05
	to rise
		when air_state == 1
		blend 0.1
	to idle
		when air_state == 0
		blend 0.2
state land
	clip animations/a_humanoid_land.voxa
	playback once
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to rise
		when air_state == 1
		blend 0.05
	to run
		when speed > 0
		blend 0.25
	to idle
		wait end
		blend 0.1
state land_hard
	clip animations/a_humanoid_land_hard.voxa
	playback once
	to idle
		wait end
		blend 0.1
state dodge_roll
	clip animations/a_humanoid_dodge_roll.voxa
	playback once
	to run
		when speed > 0
		wait end
		blend 0.1
	to idle
		wait end
		blend 0.1
state dodge_dash
	clip animations/a_humanoid_dodge_dash.voxa
	playback once
	to run
		when speed > 0
		wait end
		blend 0.1
	to idle
		wait end
		blend 0.1
state stance_idle
	clip animations/a_humanoid_stance_idle.voxa
	playback loop
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
	to run
		when stance == 0
		when speed > 0
		blend 0.15
	to idle
		when stance == 0
		blend 0.15
	to walk_f
		when speed > 0
		when dir_z >= 0.5
		blend 0.12
	to walk_b
		when speed > 0
		when dir_z <= -0.5
		blend 0.12
	to walk_l
		when speed > 0
		when dir_x <= -0.5
		blend 0.12
	to walk_r
		when speed > 0
		when dir_x >= 0.5
		blend 0.12
state walk_f
	clip animations/a_humanoid_walk_f.voxa
	playback loop
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
	to run
		when stance == 0
		when speed > 0
		blend 0.15
	to idle
		when stance == 0
		blend 0.15
	to stance_idle
		when speed == 0
		blend 0.15
	to walk_b
		when dir_z < -0.75
		blend 0.1
	to walk_l
		when dir_x < -0.75
		blend 0.1
	to walk_r
		when dir_x > 0.75
		blend 0.1
state walk_b
	clip animations/a_humanoid_walk_b.voxa
	playback loop
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
	to run
		when stance == 0
		when speed > 0
		blend 0.15
	to idle
		when stance == 0
		blend 0.15
	to stance_idle
		when speed == 0
		blend 0.15
	to walk_f
		when dir_z > 0.75
		blend 0.1
	to walk_l
		when dir_x < -0.75
		blend 0.1
	to walk_r
		when dir_x > 0.75
		blend 0.1
state walk_l
	clip animations/a_humanoid_walk_l.voxa
	playback loop
	rate 2
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
	to run
		when stance == 0
		when speed > 0
		blend 0.15
	to idle
		when stance == 0
		blend 0.15
	to stance_idle
		when speed == 0
		blend 0.15
	to walk_f
		when dir_z > 0.75
		blend 0.1
	to walk_b
		when dir_z < -0.75
		blend 0.1
	to walk_r
		when dir_x > 0.75
		blend 0.1
state walk_r
	clip animations/a_humanoid_walk_r.voxa
	playback loop
	rate 2
	to dodge_roll
		on dodge_roll
		blend 0.05
	to dodge_dash
		on dodge_dash
		blend 0.03
	to rise
		when air_state == 1
		blend 0.02
	to fall
		when air_state == 2
		blend 0.15
	to run
		when stance == 0
		when speed > 0
		blend 0.15
	to idle
		when stance == 0
		blend 0.15
	to stance_idle
		when speed == 0
		blend 0.15
	to walk_f
		when dir_z > 0.75
		blend 0.1
	to walk_b
		when dir_z < -0.75
		blend 0.1
	to walk_l
		when dir_x < -0.75
		blend 0.1
