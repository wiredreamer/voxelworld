		blend 0.06
	to none
		wait end
		wait blend
state bow_redraw
	clip animations/a_humanoid_bow_redraw.voxa
	playback once
	fade_in 0.06
	fade_out 0.15
	to none
		on dodge
		blend 0.05
	to bow_release
		when bow_state == 3
		blend 0.04
	to bow_hold
		when bow_state == 2
		blend 0.08
	to none
		when bow_state == 0
		blend 0.12
state charge
	clip animations/a_humanoid_attack_charge.voxa
	playback once
	fade_in 0.06
	fade_out 0.15
	to none
		on dodge
		blend 0.05
	to charged
		when charging == 2
		blend 0.05
	to none
		when charging == 0
		blend 0.12
state charged
	clip animations/a_humanoid_attack_charged.voxa
	playback once
	fade_in 0.04
	fade_out 0.2
	to none
		on dodge
		blend 0.05
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to none
		wait end
		wait blend
state whirl
	clip animations/a_humanoid_sword_whirl_start.voxa
	playback once
	fade_in 0.06
	fade_out 0.2
	to none
		on dodge
		blend 0.05
	to whirl_spin
		when whirl_phase == 2
		blend 0.05
	to whirl_end
		when whirl_phase == 3
		blend 0.05
	to none
		when whirl_phase == 0
		blend 0.12
state whirl_spin
	clip animations/a_humanoid_sword_whirl_spin.voxa
	playback loop
	fade_in 0.05
	fade_out 0.15
	to none
		on dodge
		blend 0.05
	to whirl_end
		when whirl_phase == 3
		blend 0.05
	to none
		when whirl_phase == 0
		blend 0.12
state whirl_end
