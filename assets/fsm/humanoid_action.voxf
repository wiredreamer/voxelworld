	playback once
	fade_in 0.05
	fade_out 0.2
	to none
		on dodge
		blend 0.05
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to none
		wait end
		wait blend
state pommel
	clip animations/a_humanoid_sword_pommel.voxa
	playback once
	fade_in 0.05
	fade_out 0.2
	to none
		on dodge
		blend 0.05
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to none
		wait end
		wait blend
