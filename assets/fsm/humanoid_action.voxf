# Voxf File Version 1.0
rig humanoid
entry none
param attack trigger
param dodge trigger
param attack_chain int
param block bool
param block_impact trigger
param bow_state int
param charging int
param whirl trigger
param whirl_phase int
param pommel trigger
state none
	playback loop
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to attack_2
		on attack
		when attack_chain == 2
		blend 0.08
	to attack_3
		on attack
		when attack_chain == 3
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to bow_draw
		when bow_state == 1
		blend 0.1
state attack_1
	clip animations/a_humanoid_attack_1.voxa
	playback once
	fade_in 0.06
	fade_out 0.2
	to charge
		when charging == 1
		blend 0.1
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to none
		on dodge
		blend 0.05
	to attack_2
		on attack
		when attack_chain == 2
		blend 0.08
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to none
		wait end
		wait blend
state attack_2
	clip animations/a_humanoid_attack_2.voxa
	playback once
	fade_in 0.06
	fade_out 0.2
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to none
		on dodge
		blend 0.05
	to attack_3
		on attack
		when attack_chain == 3
		blend 0.08
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to none
		wait end
		wait blend
state attack_3
	clip animations/a_humanoid_attack_3.voxa
	playback once
	fade_in 0.06
	fade_out 0.2
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to none
		on dodge
		blend 0.05
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to block
		when block == 1
		blend 0.12
	to none
		wait end
		wait blend
state block
	clip animations/a_humanoid_block_idle.voxa
	playback loop
	fade_in 0.12
	fade_out 0.15
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to attack_2
		on attack
		when attack_chain == 2
		blend 0.08
	to attack_3
		on attack
		when attack_chain == 3
		blend 0.08
	to none
		on dodge
		blend 0.05
	to block_impact
		on block_impact
		blend 0.03
	to none
		when block == 0
		blend 0.12
state block_impact
	clip animations/a_humanoid_block_impact.voxa
	playback once
	fade_in 0.05
	fade_out 0.15
	to whirl
		on whirl
		blend 0.08
	to pommel
		on pommel
		blend 0.06
	to attack_1
		on attack
		when attack_chain == 1
		blend 0.08
	to attack_2
		on attack
		when attack_chain == 2
		blend 0.08
	to attack_3
		on attack
		when attack_chain == 3
		blend 0.08
	to none
		on dodge
		blend 0.05
	to block_impact
		on block_impact
		blend 0.02
	to none
		when block == 0
		blend 0.12
	to block
		wait end
		blend 0.08
state bow_draw
	clip animations/a_humanoid_bow_draw.voxa
	playback once
	fade_in 0.08
	fade_out 0.15
	to none
		on dodge
		blend 0.05
	to bow_release
		when bow_state == 3
		blend 0.04
	to bow_hold
		when bow_state == 2
		blend 0.08
	to none
		when bow_state == 0
		blend 0.12
state bow_hold
	clip animations/a_humanoid_bow_hold.voxa
	playback loop
	fade_in 0.08
	fade_out 0.15
	to none
		on dodge
		blend 0.05
	to bow_release
		when bow_state == 3
		blend 0.03
	to none
		when bow_state == 0
		blend 0.12
state bow_release
	clip animations/a_humanoid_bow_release.voxa
	playback once
	fade_in 0.03
	fade_out 0.18
	to none
		on dodge
		blend 0.05
	to bow_redraw
